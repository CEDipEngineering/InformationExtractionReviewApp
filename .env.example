# ── Databricks auth (local dev only) ────────────────────────────────────────
# Profile name in ~/.databrickscfg to use when running locally.
# Ignored when deployed as a Databricks App (auth is handled automatically).
DATABRICKS_CONFIG_PROFILE=fevm

# ── SQL warehouse ────────────────────────────────────────────────────────────
SQL_WAREHOUSE_ID=2c3975c5e258e46b

# ── Source table ─────────────────────────────────────────────────────────────
# Points at the raw_parsed_content table produced by the parse pipeline.
# Update to the Agent Bricks extraction output table once that step is configured.
TABLE_NAME=cedip_fevm_aws_classic_stable_catalog.ai.raw_parsed_content

# Column names (change these if you point the app at a different table)
COL_PDF_PATH=path
COL_LABELS=labels
COL_RAW_CONTENT=raw_parsed

# ── Destination table (writeback) ────────────────────────────────────────────
# Reviewed/corrected records are inserted here with change_author and timestamp.
DEST_TABLE_NAME=cedip_fevm_aws_classic_stable_catalog.ai.reviewed_records
